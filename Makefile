# --- Переменные ---
# CC — компилятор, который мы используем.
# В macOS/Linux это обычно gcc (или clang, который часто скрывается под именем gcc).
CC = gcc

# CFLAGS — флаги (опции), которые передаются компилятору.
# -Wall -Wextra : Включают максимальное количество предупреждений (чтобы ловить баги).
# -O3           : Максимальный уровень оптимизации (код будет работать быстрее).
# -march=native : Компилятор задействует все фишки конкретно твоего процессора (например, Apple M4).
# -flto         : Link Time Optimization (оптимизация на этапе линковки, склеивает и оптимизирует весь проект целиком).
# -Iinclude     : Говорит компилятору искать заголовочные файлы (.h) в папке include.
CFLAGS = -Wall -Wextra -O3 -march=native -flto -Iinclude

# TARGET — имя финального исполняемого файла (программы).
TARGET = shark24

# OBJS — список объектных файлов (.o), которые нужно создать из исходников (.c).
# Сначала компилятор создаст каждый .o файл, а потом склеит их в один TARGET.
OBJS = src/main.o src/walker.o src/search.o

# --- Правила (Rules) ---
# Первое правило — это то, что выполняется по умолчанию (когда ты просто пишешь "make").
# Оно говорит: "Чтобы собрать всё, нужно собрать $(TARGET)".
all: $(TARGET)

# Правило для сборки финального бинарника ($(TARGET) = shark24).
# Оно зависит от объектных файлов ($(OBJS)). Если они изменились, Make пересоберет программу.
$(TARGET): $(OBJS)
	# ВНИМАНИЕ: Перед этой командой ОБЯЗАТЕЛЬНО должен быть символ Tab (табуляция)!
	# $(CC) берет компилятор, $(CFLAGS) — флаги, -o $(TARGET) — имя выходного файла.
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS)

# Шаблонное правило (Pattern Rule) для компиляции .c файлов в .o файлы.
# Символ % — это "wildcard" (любое имя). 
# src/%.o: src/%.c означает: "Чтобы получить любой .o файл в папке src, возьми соответствующий .c файл из src".
src/%.o: src/%.c
	# $< — это специальная переменная Make, которая означает "первую зависимость" (то есть .c файл).
	# $@ — означает "цель" (то есть .o файл).
	# -c говорит компилятору: "Только скомпилируй, но не линкуй".
	$(CC) $(CFLAGS) -c $< -o $@

# Правило для очистки проекта от мусора (объектных файлов и бинарника).
# Вызывается командой "make clean".
clean:
	# Удаляет (-f — force, без подтверждения) все .o файлы и финальный бинарник.
	rm -f $(OBJS) $(TARGET)